generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Voluntario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  telefone  String?
  status    String   @default("pendente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
